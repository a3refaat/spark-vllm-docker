+// Store one lane's four elements into the main K/V cache.  For normal BF16/FP16
+// cache this is the same vectorized store as qkv/index-cache.  For fp8 cache the
+// sparse M3 attention kernels currently dequantize by simple dtype conversion
+// (no per-layer K/V scales), so use an identity scale here as well.
+template <typename scalar_t, typename cache_t, Fp8KVCacheDataType kv_dt>
+__device__ __forceinline__ void storeCacheElems(
+    cache_t* __restrict__ dst, float const (&elems)[kElemsPerLane]) {
+  if constexpr (kv_dt == Fp8KVCacheDataType::kAuto) {
+    storeElems<scalar_t>(reinterpret_cast<scalar_t*>(dst), elems);
+  } else {
+#pragma unroll
+    for (int i = 0; i < kElemsPerLane; i++) {
+      dst[i] = fp8::scaled_convert<cache_t, float, kv_dt>(elems[i], 1.0f);
+    }
+  }
+}
